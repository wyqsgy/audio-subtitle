{
  "name": "audio-subtitle",
  "version": "2.0.0",
  "description": "实时音频字幕翻译工具 - 将电脑音频实时转为字幕",
  "author": "Audio Subtitle",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:frontend": "vite build",
    "build:installer": "vite build && electron-builder --win",
    "build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^0.314.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.14",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.audiosubtitle.app",
    "productName": "Audio Subtitle",
    "copyright": "Copyright © 2026 Audio Subtitle",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/audiosubtitle-backend.exe",
        "to": "backend/audiosubtitle-backend.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Audio Subtitle",
      "license": "build-resources/license.txt",
      "installerSidebar": null,
      "uninstallDisplayName": "Audio Subtitle",
      "include": "build-resources/installer.nsh",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "warningsAsErrors": false,
      "unicode": true,
      "runAfterFinish": true,
      "menuCategory": "Audio Subtitle"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
